/**
 * Nova:
 * - channel "nova/media": daftar lagu + cover dari MediaStore, dan "moveToBack".
 * - channel "nova/overlay": pulau di notch yang tetap tampil di luar app.
 */
private const val REQ_BACKUP_SAVE = 7101
private const val REQ_BACKUP_OPEN = 7102
private const val REQ_COVER_PICK = 7103
private const val REQ_DELETE = 7104

class MainActivity : AudioServiceActivity() {
    private val main = Handler(Looper.getMainLooper())

    // Cadangan data: pilih tempat simpan / file lewat pemilih file Android (tanpa izin tambahan).
    private var backupResult: MethodChannel.Result? = null
    private var backupContent: String? = null

    // Foto lagu & hapus lagu: nunggu jawaban dari pemilih foto / dialog hapus Android.
    private var coverResult: MethodChannel.Result? = null
    private var coverSongId: Long = -1
    private var deleteResult: MethodChannel.Result? = null
    private var deleteIds: List<Long> = emptyList()

    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        super.onActivityResult(requestCode, resultCode, data)
        if (requestCode == REQ_COVER_PICK) {
            val res = coverResult ?: return
            coverResult = null
            val uri = data?.data
            if (resultCode != RESULT_OK || uri == null) {
                res.success(null)
                return
            }
            val id = coverSongId
            NovaMedia.io.execute {
                val path = try {
                    NovaMedia.saveCover(applicationContext, id, uri)
                } catch (e: Exception) {
                    null
                }
                main.post { if (path == null) res.error("cover", "Foto gak bisa dibaca", null) else res.success(path) }
            }
            return
        }
        if (requestCode == REQ_DELETE) {
            val res = deleteResult ?: return
            deleteResult = null
            if (resultCode != RESULT_OK) {
                res.success(false)
                return
            }
            // Android 10: izin udah dikasih, sekarang beneran dihapus.
            if (Build.VERSION.SDK_INT == Build.VERSION_CODES.Q) {
                NovaMedia.io.execute {
                    val ok = try {
                        NovaMedia.deleteDirect(applicationContext, deleteIds)
                    } catch (e: Exception) {
                        false
                    }
                    main.post { res.success(ok) }
                }
            } else {
                deleteIds.forEach { NovaMedia.coverFile(applicationContext, it).delete() }
                res.success(true)
            }
            return
        }
        if (requestCode != REQ_BACKUP_SAVE && requestCode != REQ_BACKUP_OPEN) return
        val res = backupResult ?: return
        backupResult = null
        val uri = data?.data
        if (resultCode != RESULT_OK || uri == null) {
            res.success(null) // dibatalin
            return
        }
        val content = backupContent
        backupContent = null
        NovaMedia.io.execute {
            try {
                if (requestCode == REQ_BACKUP_SAVE) {
                    contentResolver.openOutputStream(uri, "wt")!!.use { it.write((content ?: "").toByteArray(Charsets.UTF_8)) }
                    main.post { res.success("ok") }
                } else {
                    val text = contentResolver.openInputStream(uri)!!.use { input ->
                        val bytes = input.readBytes()
                        if (bytes.size > 5_000_000) throw IllegalStateException("kegedean")
                        String(bytes, Charsets.UTF_8)
                    }
                    main.post { res.success(text) }
                }
            } catch (e: Exception) {
                main.post { res.error("backup", e.message, null) }
            }
        }
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        NovaOverlay.init(applicationContext)
        val messenger = flutterEngine.dartExecutor.binaryMessenger

        MethodChannel(messenger, "nova/media").setMethodCallHandler { call, result ->
            when (call.method) {
                "songs" -> NovaMedia.io.execute {
                    try {
                        val list = NovaMedia.querySongs(applicationContext)
                        main.post { result.success(list) }
                    } catch (e: Exception) {
                        main.post { result.error("query", e.message, null) }
                    }
                }
                "artwork" -> {
                    val id = call.argument<Number>("id")?.toLong()
                    val size = call.argument<Number>("size")?.toInt() ?: 300
                    if (id == null) {
                        result.success(null)
                    } else {
                        NovaMedia.io.execute {
                            val bytes = try {
                                NovaMedia.artworkBytes(applicationContext, id, size)
                            } catch (e: Exception) {
                                null
                            }
                            main.post { result.success(bytes) }
                        }
                    }
                }
                // ---- Foto lagu buatan sendiri ----
                "coverDir" -> result.success(NovaMedia.coverDir(applicationContext).absolutePath)
                "coverIds" -> result.success(NovaMedia.coverIds(applicationContext))
                "pickCover" -> {
                    coverResult?.success(null)
                    coverResult = result
                    coverSongId = call.argument<Number>("id")?.toLong() ?: -1
                    val i = Intent(Intent.ACTION_GET_CONTENT)
                        .addCategory(Intent.CATEGORY_OPENABLE)
                        .setType("image/*")
                    startActivityForResult(Intent.createChooser(i, "Pilih foto lagu"), REQ_COVER_PICK)
                }
                "removeCover" -> {
                    val id = call.argument<Number>("id")?.toLong() ?: -1
                    result.success(NovaMedia.coverFile(applicationContext, id).delete())
                }
                // ---- Hapus file lagu dari HP (Android minta konfirmasi sendiri) ----
                "deleteSongs" -> {
                    val ids = (call.argument<List<Number>>("ids") ?: emptyList()).map { it.toLong() }
                    if (ids.isEmpty()) {
                        result.success(false)
                    } else {
                        deleteResult?.success(false)
                        deleteResult = result
                        deleteIds = ids
                        val uris = ids.map { ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, it) }
                        try {
                            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                                val req = MediaStore.createDeleteRequest(contentResolver, uris)
                                startIntentSenderForResult(req.intentSender, REQ_DELETE, null, 0, 0, 0)
                            } else {
                                NovaMedia.io.execute {
                                    try {
                                        val ok = NovaMedia.deleteDirect(applicationContext, ids)
                                        main.post { deleteResult = null; result.success(ok) }
                                    } catch (e: android.app.RecoverableSecurityException) {
                                        main.post {
                                            startIntentSenderForResult(
                                                e.userAction.actionIntent.intentSender, REQ_DELETE, null, 0, 0, 0,
                                            )
                                        }
                                    } catch (e: Exception) {
                                        main.post { deleteResult = null; result.error("delete", e.message, null) }
                                    }
                                }
                            }
                        } catch (e: Exception) {
                            deleteResult = null
                            result.error("delete", e.message, null)
                        }
                    }
                }
                "lyrics" -> {
                    val id = call.argument<Number>("id")?.toLong()
                    if (id == null) {
                        result.success(null)
                    } else {
                        NovaMedia.io.execute {
                            val text = try {
                                NovaMedia.embeddedLyrics(applicationContext, id)
                            } catch (e: Exception) {
                                null
                            }
                            main.post { result.success(text) }
                        }
                    }
                }
                // Tombol back di layar utama: sembunyikan app, musik tetap jalan.
                "moveToBack" -> {
                    moveTaskToBack(true)
                    result.success(null)
                }
                else -> result.notImplemented()
            }
        }

        MethodChannel(messenger, "nova/backup").setMethodCallHandler { call, result ->
            when (call.method) {
                "save" -> {
                    backupResult?.success(null)
                    backupResult = result
                    backupContent = call.argument<String>("content") ?: ""
                    val i = Intent(Intent.ACTION_CREATE_DOCUMENT)
                        .addCategory(Intent.CATEGORY_OPENABLE)
                        .setType("application/json")
                        .putExtra(Intent.EXTRA_TITLE, call.argument<String>("name") ?: "nova-cadangan.json")
                    startActivityForResult(i, REQ_BACKUP_SAVE)
                }
                "open" -> {
                    backupResult?.success(null)
                    backupResult = result
                    val i = Intent(Intent.ACTION_OPEN_DOCUMENT)
                        .addCategory(Intent.CATEGORY_OPENABLE)
                        .setType("*/*")
                        .putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("application/json", "text/plain", "application/octet-stream"))
                    startActivityForResult(i, REQ_BACKUP_OPEN)
                }
                // Habis pulihin cadangan: buka ulang Nova biar semua data kebaca bersih.
                "restart" -> {
                    result.success(null)
                    val launch = packageManager.getLaunchIntentForPackage(packageName)
                    if (launch?.component != null) {
                        startActivity(Intent.makeRestartActivityTask(launch.component))
                    }
                    main.postDelayed({ Runtime.getRuntime().exit(0) }, 300)
                }
                else -> result.notImplemented()
            }
        }

        val overlayChannel = MethodChannel(messenger, "nova/overlay")
        NovaOverlay.channel = overlayChannel
        overlayChannel.setMethodCallHandler { call, result ->
            when (call.method) {
                "canDraw" -> result.success(NovaOverlay.canDraw(this))
                "requestPermission" -> {
                    try {
                        startActivity(
                            Intent(
                                Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                                Uri.parse("package:$packageName"),
                            )
                        )
                    } catch (e: Exception) {
                        startActivity(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION))
                    }
                    result.success(null)
                }
                "setAutoHide" -> {
                    NovaOverlay.autoHideEnabled = call.arguments as? Boolean ?: true
                    NovaOverlay.refresh()
                    result.success(null)
                }
                "setEnabled" -> {
                    NovaOverlay.enabled = call.arguments as? Boolean ?: false
                    NovaOverlay.refresh()
                    result.success(null)
                }
                "update" -> {
                    NovaOverlay.update(
                        id = call.argument<Number>("id")?.toLong() ?: -1L,
                        title = call.argument<String>("title") ?: "",
                        artist = call.argument<String>("artist") ?: "",
                        playing = call.argument<Boolean>("playing") ?: false,
                        accentColor = call.argument<Number>("accent")?.toLong()?.toInt(),
                    )
                    // Widget layar utama ikut info yang sama.
                    NovaWidget.update(
                        applicationContext,
                        id = call.argument<Number>("id")?.toLong() ?: -1L,
                        title = call.argument<String>("title") ?: "",
                        artist = call.argument<String>("artist") ?: "",
                        playing = call.argument<Boolean>("playing") ?: false,
                        accent = call.argument<Number>("accent")?.toLong()?.toInt(),
                    )
                    result.success(null)
                }
                "test" -> result.success(NovaOverlay.test())
                "progress" -> {
                    NovaOverlay.progress(
                        pos = call.argument<Number>("pos")?.toLong() ?: 0L,
                        dur = call.argument<Number>("dur")?.toLong() ?: 0L,
                        isFav = call.argument<Boolean>("fav") ?: false,
                    )
                    result.success(null)
                }
                else -> result.notImplemented()
            }
        }
    }

    override fun onStart() {
        super.onStart()
        NovaOverlay.setAppVisible(true)
    }

    override fun onStop() {
        super.onStop()
        NovaOverlay.setAppVisible(false)
    }
}

/**
 * Layanan Aksesibilitas Nova: cuma dipakai buat nampilin pulau di notch di atas status bar
 * (TYPE_ACCESSIBILITY_OVERLAY) supaya pil tipis di kamera bisa di-tap. Gak baca isi layar.
 */
class NovaIslandService : AccessibilityService() {
    override fun onServiceConnected() {
        super.onServiceConnected()
        NovaOverlay.init(applicationContext)
        NovaOverlay.setHost(this)
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {}

    override fun onInterrupt() {}

    override fun onUnbind(intent: Intent?): Boolean {
        NovaOverlay.clearHost(this)
        return super.onUnbind(intent)
    }

    override fun onDestroy() {
        NovaOverlay.clearHost(this)
        super.onDestroy()
    }
}

/** Baca lagu & cover dari MediaStore. */
object NovaMedia {
    val io = Executors.newFixedThreadPool(3)

    @Suppress("DEPRECATION")
    fun querySongs(ctx: Context): List<Map<String, Any?>> {
        val uri = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
        val projection = arrayOf(
            MediaStore.Audio.Media._ID,
            MediaStore.Audio.Media.TITLE,
            MediaStore.Audio.Media.ARTIST,
            MediaStore.Audio.Media.ALBUM,
            MediaStore.Audio.Media.ALBUM_ID,
            MediaStore.Audio.Media.DURATION,
            MediaStore.Audio.Media.DATE_ADDED,
            MediaStore.Audio.Media.DATA,
        )
        val out = ArrayList<Map<String, Any?>>()
        ctx.contentResolver.query(
            uri,
            projection,
            "${MediaStore.Audio.Media.IS_MUSIC} != 0",
            null,
            "${MediaStore.Audio.Media.DATE_ADDED} DESC",
        )?.use { c ->
            val iId = c.getColumnIndexOrThrow(MediaStore.Audio.Media._ID)
            val iTitle = c.getColumnIndexOrThrow(MediaStore.Audio.Media.TITLE)
            val iArtist = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ARTIST)
            val iAlbum = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ALBUM)
            val iAlbumId = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ALBUM_ID)
            val iDur = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DURATION)
            val iDate = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DATE_ADDED)
            val iData = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DATA)
            while (c.moveToNext()) {
                val id = c.getLong(iId)
                out.add(
                    mapOf(
                        "id" to id,
                        "title" to c.getString(iTitle),
                        "artist" to c.getString(iArtist),
                        "album" to c.getString(iAlbum),
                        "albumId" to c.getLong(iAlbumId),
                        "duration" to c.getLong(iDur),
                        "dateAdded" to c.getLong(iDate),
                        "path" to (c.getString(iData) ?: ""),
                        "uri" to ContentUris.withAppendedId(uri, id).toString(),
                    )
                )
            }
        }
        return out
    }

    // ---- Foto lagu buatan sendiri: files/covers/<id>.jpg, didahulukan dari cover bawaan ----
    fun coverDir(ctx: Context): java.io.File = java.io.File(ctx.filesDir, "covers").apply { mkdirs() }

    fun coverFile(ctx: Context, id: Long): java.io.File = java.io.File(coverDir(ctx), "$id.jpg")

    fun coverIds(ctx: Context): List<Long> =
        coverDir(ctx).listFiles()?.mapNotNull { it.nameWithoutExtension.toLongOrNull() } ?: emptyList()

    /** Simpan foto pilihan jadi kotak 800px (dipotong tengah). */
    fun saveCover(ctx: Context, id: Long, uri: Uri): String {
        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
        ctx.contentResolver.openInputStream(uri)!!.use { BitmapFactory.decodeStream(it, null, bounds) }
        var sample = 1
        while (bounds.outWidth / (sample * 2) >= 800 && bounds.outHeight / (sample * 2) >= 800) sample *= 2
        val src = ctx.contentResolver.openInputStream(uri)!!.use {
            BitmapFactory.decodeStream(it, null, BitmapFactory.Options().apply { inSampleSize = sample })
        } ?: throw IllegalStateException("bukan gambar")
        val side = minOf(src.width, src.height)
        val square = Bitmap.createBitmap(src, (src.width - side) / 2, (src.height - side) / 2, side, side)
        val out = if (side > 800) Bitmap.createScaledBitmap(square, 800, 800, true) else square
        val file = coverFile(ctx, id)
        java.io.FileOutputStream(file).use { out.compress(Bitmap.CompressFormat.JPEG, 90, it) }
        return file.absolutePath
    }

    /** Hapus langsung (Android 10 ke bawah / setelah diizinin). */
    fun deleteDirect(ctx: Context, ids: List<Long>): Boolean {
        var all = true
        for (id in ids) {
            val n = ctx.contentResolver.delete(ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, id), null, null)
            if (n <= 0) all = false
            coverFile(ctx, id).delete()
        }
        return all
    }

    fun artworkBitmap(ctx: Context, id: Long, size: Int): Bitmap? {
        val custom = coverFile(ctx, id)
        if (custom.exists()) {
            val opts = BitmapFactory.Options().apply { inJustDecodeBounds = true }
            BitmapFactory.decodeFile(custom.absolutePath, opts)
            var s = 1
            while (opts.outWidth / (s * 2) >= size && opts.outHeight / (s * 2) >= size) s *= 2
            BitmapFactory.decodeFile(custom.absolutePath, BitmapFactory.Options().apply { inSampleSize = s })?.let { return it }
        }
        val retriever = MediaMetadataRetriever()
        try {
            retriever.setDataSource(
                ctx,
                ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, id),
            )
            val pic = retriever.embeddedPicture ?: return null
            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
            BitmapFactory.decodeByteArray(pic, 0, pic.size, bounds)
            var sample = 1
            while (bounds.outWidth / (sample * 2) >= size && bounds.outHeight / (sample * 2) >= size) {
                sample *= 2
            }
            val opts = BitmapFactory.Options().apply { inSampleSize = sample }
            return BitmapFactory.decodeByteArray(pic, 0, pic.size, opts)
        } finally {
            try {
                retriever.release()
            } catch (e: Exception) {
                // abaikan
            }
        }
    }

    /**
     * Lirik yang tertanam di file lagu:
     * - MP3: frame ID3v2 USLT (v2.3 / v2.4)
     * - FLAC: Vorbis comment LYRICS= / UNSYNCEDLYRICS=
     * Teksnya bisa berupa LRC (bertimestamp) atau lirik biasa; diparse di Dart.
     */
    fun embeddedLyrics(ctx: Context, id: Long): String? {
        val uri = ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, id)
        ctx.contentResolver.openInputStream(uri)?.use { input ->
            val head = ByteArray(10)
            if (readFully(input, head) < 10) return null
            if (head[0] == 'I'.code.toByte() && head[1] == 'D'.code.toByte() && head[2] == '3'.code.toByte()) {
                val major = head[3].toInt()
                val size = syncsafe(head, 6)
                if (size <= 0 || size > 32 * 1024 * 1024) return null
                val tag = ByteArray(size)
                val n = readFully(input, tag)
                // Lewati extended header kalau ada (flag bit 6).
                val hasExt = (head[5].toInt() and 0x40) != 0
                val start = when {
                    !hasExt || n < 4 -> 0
                    major == 4 -> syncsafe(tag, 0)
                    else -> 4 + int32(tag, 0)
                }
                return id3Uslt(tag, n, major, start.coerceIn(0, n))
            }
            val isFlac = head[0] == 'f'.code.toByte() && head[1] == 'L'.code.toByte() &&
                head[2] == 'a'.code.toByte() && head[3] == 'C'.code.toByte()
            if (!isFlac) return null
        } ?: return null
        return flacLyrics(ctx, uri)
    }

    private fun readFully(input: java.io.InputStream, buf: ByteArray, len: Int = buf.size): Int {
        var off = 0
        while (off < len) {
            val r = input.read(buf, off, len - off)
            if (r < 0) break
            off += r
        }
        return off
    }

    private fun syncsafe(b: ByteArray, at: Int): Int =
        ((b[at].toInt() and 0x7f) shl 21) or ((b[at + 1].toInt() and 0x7f) shl 14) or
            ((b[at + 2].toInt() and 0x7f) shl 7) or (b[at + 3].toInt() and 0x7f)

    private fun int32(b: ByteArray, at: Int): Int =
        ((b[at].toInt() and 0xff) shl 24) or ((b[at + 1].toInt() and 0xff) shl 16) or
            ((b[at + 2].toInt() and 0xff) shl 8) or (b[at + 3].toInt() and 0xff)

    private fun id3Uslt(tag: ByteArray, len: Int, major: Int, from: Int): String? {
        if (major != 3 && major != 4) return null
        var pos = from
        while (pos + 10 <= len) {
            val frameId = String(tag, pos, 4, Charsets.ISO_8859_1)
            if (frameId[0] == '\u0000') break
            val size = if (major == 4) syncsafe(tag, pos + 4) else int32(tag, pos + 4)
            val start = pos + 10
            if (size <= 0 || start + size > len) break
            if (frameId == "USLT" && size > 4) {
                val enc = tag[start].toInt()
                var p = start + 4 // encoding (1) + bahasa (3)
                val end = start + size
                // Lewati deskripsi (diakhiri 0 / 00 tergantung encoding).
                val wide = enc == 1 || enc == 2
                while (p < end) {
                    if (wide) {
                        if (p + 1 < end && tag[p].toInt() == 0 && tag[p + 1].toInt() == 0) { p += 2; break }
                        p += 2
                    } else {
                        if (tag[p].toInt() == 0) { p += 1; break }
                        p += 1
                    }
                }
                if (p >= end) return null
                val charset = when (enc) {
                    1 -> Charsets.UTF_16
                    2 -> Charsets.UTF_16BE
                    3 -> Charsets.UTF_8
                    else -> Charsets.ISO_8859_1
                }
                return String(tag, p, end - p, charset).trimEnd('\u0000').trim().ifEmpty { null }
            }
            pos = start + size
        }
        return null
    }

    /** FLAC: lewati "fLaC", baca blok metadata satu per satu sampai VORBIS_COMMENT (tipe 4). */
    private fun flacLyrics(ctx: Context, uri: android.net.Uri): String? {
        ctx.contentResolver.openInputStream(uri)?.use { input ->
            val magic = ByteArray(4)
            if (readFully(input, magic) < 4) return null
            val header = ByteArray(4)
            while (true) {
                if (readFully(input, header) < 4) return null
                val last = (header[0].toInt() and 0x80) != 0
                val type = header[0].toInt() and 0x7f
                val length = ((header[1].toInt() and 0xff) shl 16) or
                    ((header[2].toInt() and 0xff) shl 8) or (header[3].toInt() and 0xff)
                if (type == 4) {
                    if (length > 16 * 1024 * 1024) return null
                    val body = ByteArray(length)
                    if (readFully(input, body) < length) return null
                    return vorbisLyrics(body)
                }
                if (last) return null
                var skip = length.toLong()
                while (skip > 0) {
                    val k = input.skip(skip)
                    if (k <= 0) return null
                    skip -= k
                }
            }
        }
        return null
    }

    private fun vorbisLyrics(b: ByteArray): String? {
        fun le32(at: Int): Int =
            (b[at].toInt() and 0xff) or ((b[at + 1].toInt() and 0xff) shl 8) or
                ((b[at + 2].toInt() and 0xff) shl 16) or ((b[at + 3].toInt() and 0xff) shl 24)
        if (b.size < 8) return null
        var p = 0
        val vendor = le32(p); p += 4 + vendor
        if (p + 4 > b.size) return null
        val count = le32(p); p += 4
        var fallback: String? = null
        repeat(count) {
            if (p + 4 > b.size) return fallback
            val len = le32(p); p += 4
            if (len < 0 || p + len > b.size) return fallback
            val kv = String(b, p, len, Charsets.UTF_8); p += len
            val eq = kv.indexOf('=')
            if (eq > 0) {
                val key = kv.substring(0, eq).uppercase()
                val value = kv.substring(eq + 1)
                if (key == "LYRICS" && value.isNotBlank()) return value
                if (key == "UNSYNCEDLYRICS" && value.isNotBlank()) fallback = value
            }
        }
        return fallback
    }

    fun artworkBytes(ctx: Context, id: Long, size: Int): ByteArray? {
        val bmp = artworkBitmap(ctx, id, size) ?: return null
        val stream = ByteArrayOutputStream()
        bmp.compress(Bitmap.CompressFormat.JPEG, 88, stream)
        bmp.recycle()
        return stream.toByteArray()
    }
}

/**
 * Pulau di notch versi luar app (izin "tampil di atas app lain").
 * Tiga tahap:
 *  - HIDDEN  : kapsul kecil di notch. Tap = muncul jadi pil.
 *  - PILL    : cover + judul + play/jeda. Tap = kartu lagu, geser ke atas = sembunyi.
 *  - EXPANDED: kartu kayak notifikasi (sebelumnya / play / berikutnya / buka Nova).
 *              Tap kosong / tap di luar = balik ke pil, geser ke atas = sembunyi.
 */
@SuppressLint("StaticFieldLeak")
object NovaOverlay {
    enum class Mode { HIDDEN, PILL, EXPANDED }

    var enabled = false

    /** Channel balik ke Dart (seek / favorit dari kartu di luar app). */
    var channel: MethodChannel? = null

    /** Layanan Aksesibilitas yang aktif (null = pakai jendela overlay biasa). */
    private var host: AccessibilityService? = null
    private var attachedWm: WindowManager? = null

    val precise: Boolean get() = host != null

    fun setHost(service: AccessibilityService) {
        detach()
        host = service
        refresh()
    }

    fun clearHost(service: AccessibilityService) {
        if (host !== service) return
        detach()
        host = null
        refresh()
    }

    private var ctx: Context? = null
    private val main = Handler(Looper.getMainLooper())
    private var appVisible = true
    private var mode = Mode.HIDDEN
    private var testUntil = 0L

    private var songId = -1L
    private var title = ""
    private var artist = ""
    private var playing = false
    private var coverBmp: Bitmap? = null

    private var root: FrameLayout? = null
    private var params: WindowManager.LayoutParams? = null

    private val text = Color.rgb(236, 238, 245)
    private val muted = Color.rgb(143, 149, 168)
    private var accent = Color.rgb(174, 185, 255)
    private val onAccent = Color.rgb(12, 16, 48)

    fun init(c: Context) {
        if (ctx == null) ctx = c.applicationContext
    }

    private var probedOk = false

    /**
     * Cek izin "tampil di atas app lain" berlapis. Oppo/ColorOS kadang balikin false
     * dari Settings.canDrawOverlays walau saklarnya udah nyala.
     */
    fun canDraw(c: Context): Boolean {
        if (host != null || Build.VERSION.SDK_INT < 23 || probedOk) return true
        if (Settings.canDrawOverlays(c)) return true
        try {
            val ops = c.getSystemService(Context.APP_OPS_SERVICE) as AppOpsManager
            val mode = if (Build.VERSION.SDK_INT >= 29) {
                ops.unsafeCheckOpNoThrow(AppOpsManager.OPSTR_SYSTEM_ALERT_WINDOW, Process.myUid(), c.packageName)
            } else {
                @Suppress("DEPRECATION")
                ops.checkOpNoThrow(AppOpsManager.OPSTR_SYSTEM_ALERT_WINDOW, Process.myUid(), c.packageName)
            }
            if (mode == AppOpsManager.MODE_ALLOWED) return true
        } catch (e: Exception) {
            // lanjut ke cara terakhir
        }
        return probe(c)
    }

    /** Coba tempel jendela 1px tak terlihat. Kalau sistem nerima, izinnya sebenernya ada. */
    private fun probe(c: Context): Boolean {
        if (Looper.myLooper() != Looper.getMainLooper()) return false
        @Suppress("DEPRECATION")
        val type = if (Build.VERSION.SDK_INT >= 26) {
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
        } else {
            WindowManager.LayoutParams.TYPE_PHONE
        }
        val view = View(c)
        val p = WindowManager.LayoutParams(
            1, 1, type,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE,
            PixelFormat.TRANSLUCENT,
        )
        return try {
            val wm = c.getSystemService(Context.WINDOW_SERVICE) as WindowManager
            wm.addView(view, p)
            wm.removeView(view)
            probedOk = true
            true
        } catch (e: Exception) {
            false
        }
    }

    /** Kapsul ngilang sendiri setelah beberapa detik; muncul lagi pas ada kejadian. */
    var autoHideEnabled = true
    private var gone = false
    private const val GONE_MS = 4000L
    private val goneRunnable = Runnable {
        if (mode != Mode.HIDDEN || !autoHideEnabled) return@Runnable
        val child = root?.getChildAt(0)
        if (child == null) {
            gone = true
            render()
        } else {
            child.animate().alpha(0f).translationY(-dp(24f).toFloat()).scaleX(0.6f).setDuration(220)
                .withEndAction {
                    gone = true
                    render()
                }.start()
        }
    }

    /** Munculin kapsul lagi (ganti lagu / play-jeda / keluar dari Nova). */
    private fun wake() {
        val wasGone = gone
        gone = false
        main.removeCallbacks(goneRunnable)
        if (wasGone) render()
    }

    fun setAppVisible(visible: Boolean) {
        appVisible = visible
        if (!visible) wake()
        refresh()
    }

    fun update(id: Long, title: String, artist: String, playing: Boolean, accentColor: Int? = null) {
        val changed = id != songId
        val colorChanged = accentColor != null && accentColor != accent
        if (accentColor != null) accent = accentColor
        // Gak ada yang berubah → gak usah gambar ulang (timer sembunyi gak ke-reset).
        if (!changed && !colorChanged && playing == this.playing && title == this.title && artist == this.artist) return
        if (changed || playing != this.playing) wake()
        songId = id
        this.title = title
        this.artist = artist
        this.playing = playing
        if (changed) {
            coverBmp = null
            loadCover()
        }
        refresh()
        render()
    }

    /** Tampilkan pil 5 detik walau Nova lagi dibuka, buat ngetes izin. Balikin pesan error kalau gagal. */
    fun test(): String? {
        val c = ctx ?: return "Nova belum siap"
        if (!canDraw(c)) return "Izin \"tampil di atas aplikasi lain\" belum aktif"
        if (songId < 0) return "Putar satu lagu dulu"
        testUntil = System.currentTimeMillis() + 5000
        mode = Mode.EXPANDED
        main.postDelayed({ refresh() }, 5100)
        return refresh()
    }

    fun refresh(): String? {
        val c = ctx ?: return null
        val testing = System.currentTimeMillis() < testUntil
        val show = (enabled || testing) && (!appVisible || testing || host != null) && songId >= 0 && canDraw(c)
        return if (show) attach(c) else {
            detach()
            null
        }
    }

    private fun dp(v: Float): Int {
        val c = ctx ?: return v.toInt()
        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, c.resources.displayMetrics).toInt()
    }

    private fun loadCover() {
        val c = ctx ?: return
        val id = songId
        NovaMedia.io.execute {
            val bmp = try {
                NovaMedia.artworkBitmap(c, id, 160)
            } catch (e: Exception) {
                null
            }
            main.post {
                if (id == songId) {
                    coverBmp = bmp
                    render()
                }
            }
        }
    }

    private fun wm(c: Context) = c.getSystemService(Context.WINDOW_SERVICE) as WindowManager

    @SuppressLint("ClickableViewAccessibility")
    private fun attach(c: Context): String? {
        if (root != null) return null
        val frame = FrameLayout(c)

        val gestures = GestureDetector(c, object : GestureDetector.SimpleOnGestureListener() {
            override fun onDown(e: MotionEvent): Boolean = true

            override fun onSingleTapUp(e: MotionEvent): Boolean {
                // Pegangan kaca di-tap: munculin kapsulnya lagi.
                if (gone) {
                    wake()
                    return true
                }
                setMode(if (mode == Mode.HIDDEN) Mode.EXPANDED else Mode.HIDDEN)
                return true
            }

            override fun onFling(e1: MotionEvent?, e2: MotionEvent, vx: Float, vy: Float): Boolean {
                if (vy < -500 && mode != Mode.HIDDEN) {
                    setMode(Mode.HIDDEN)
                    return true
                }
                if (vy > 500 && mode != Mode.EXPANDED) {
                    setMode(Mode.EXPANDED)
                    return true
                }
                return false
            }

            override fun onLongPress(e: MotionEvent) {
                openApp(c)
            }
        })
        frame.setOnTouchListener { _, ev ->
            if (ev.action == MotionEvent.ACTION_OUTSIDE) {
                if (mode == Mode.EXPANDED) setMode(Mode.HIDDEN)
                true
            } else {
                gestures.onTouchEvent(ev)
            }
        }

        @Suppress("DEPRECATION")
        val type = when {
            host != null -> WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY
            Build.VERSION.SDK_INT >= 26 -> WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
            else -> WindowManager.LayoutParams.TYPE_PHONE
        }
        val p = WindowManager.LayoutParams(
            dp(210f),
            dp(34f),
            type,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH or
                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT,
        ).apply {
            gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
            if (Build.VERSION.SDK_INT >= 28) {
                layoutInDisplayCutoutMode =
                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
            }
        }

        try {
            val windowManager = wm(host ?: c)
            windowManager.addView(frame, p)
            attachedWm = windowManager
        } catch (e: Exception) {
            return "Gagal tampil: ${e.javaClass.simpleName} ${e.message ?: ""}".trim()
        }
        root = frame
        params = p
        render()
        return null
    }

    private fun detach() {
        val view = root ?: return
        root = null
        params = null
        val windowManager = attachedWm
        attachedWm = null
        try {
            (windowManager ?: ctx?.let { wm(it) })?.removeView(view)
        } catch (e: Exception) {
            // abaikan
        }
    }

    /** Kartu pemutar nyusut sendiri jadi kapsul kalau dibiarin. */
    private const val AUTO_HIDE_MS = 5000L
    private val autoHide = Runnable { if (mode == Mode.EXPANDED) setMode(Mode.HIDDEN) }

    private fun setMode(m: Mode) {
        mode = m
        render()
    }

    private fun statusBarHeight(c: Context): Int {
        val id = c.resources.getIdentifier("status_bar_height", "dimen", "android")
        return if (id > 0) c.resources.getDimensionPixelSize(id) else dp(24f)
    }

    /** Bangun ulang isi pulau sesuai tahap sekarang. */
    private fun render() {
        val c = ctx ?: return
        val frame = root ?: return
        val p = params ?: return
        frame.removeAllViews()
        // Tiap kartu dibangun ulang (buka / tombol ditekan / ganti lagu), timer diulang.
        main.removeCallbacks(autoHide)
        main.removeCallbacks(goneRunnable)
        if (mode == Mode.EXPANDED) main.postDelayed(autoHide, AUTO_HIDE_MS)
        if (mode == Mode.HIDDEN && autoHideEnabled && !gone) main.postDelayed(goneRunnable, GONE_MS)
        val statusH = statusBarHeight(c)
        val screenW = c.resources.displayMetrics.widthPixels

        // Lagi ngumpet: sisain pegangan kaca kecil tepat di bawah status bar buat di-tap.
        if (gone && mode == Mode.HIDDEN) {
            p.width = dp(76f)
            p.height = dp(26f)
            p.y = statusH + dp(2f)
            val handle = handleView(c)
            frame.addView(handle, FrameLayout.LayoutParams(dp(52f), dp(10f), Gravity.CENTER))
            try {
                (attachedWm ?: wm(c)).updateViewLayout(frame, p)
            } catch (e: Exception) {
                // abaikan
            }
            handle.alpha = 0f
            handle.animate().alpha(1f).setDuration(200).start()
            return
        }

        val child: View = when (mode) {
            // Mode Aksesibilitas: pil tipis pas di lubang kamera (cover kiri, equalizer kanan,
            // tengah kosong buat kamera). Tanpa Aksesibilitas, status bar nyerap tap, jadi
            // pilnya turun tepat di bawah status bar dan boleh nampilin judul.
            Mode.HIDDEN, Mode.PILL -> {
                p.height = dp(30f)
                if (host != null) {
                    p.width = dp(150f)
                    p.y = maxOf(0, (statusH - dp(30f)) / 2)
                } else {
                    p.width = dp(200f)
                    p.y = statusH + dp(4f)
                }
                hiddenView(c, showTitle = host == null)
            }
            // Kartu pemutar ngambang di bawah status bar.
            Mode.EXPANDED -> {
                p.width = screenW - dp(20f)
                // Tinggi pasti: latar blur pakai MATCH_PARENT, kalau WRAP_CONTENT kartunya jadi satu layar.
                p.height = dp(202f)
                p.y = statusH + dp(8f)
                expandedView(c)
            }
        }
        frame.addView(
            child,
            FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT,
            ),
        )
        try {
            (attachedWm ?: wm(c)).updateViewLayout(frame, p)
        } catch (e: Exception) {
            // abaikan
        }
        child.alpha = 0f
        child.scaleX = 0.92f
        child.scaleY = 0.92f
        child.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(180).start()
    }

    private fun panelBg(radius: Float) = GradientDrawable().apply {
        setColor(Color.BLACK)
        cornerRadius = dp(radius).toFloat()
        setStroke(dp(1f), Color.argb(34, 255, 255, 255))
    }

    private fun circle(color: Int) = GradientDrawable().apply {
        shape = GradientDrawable.OVAL
        setColor(color)
    }

    private fun coverView(c: Context, size: Float, round: Boolean): ImageView =
        ImageView(c).apply {
            scaleType = ImageView.ScaleType.CENTER_CROP
            setBackgroundColor(Color.argb(30, 255, 255, 255))
            coverBmp?.let { setImageBitmap(it) }
            outlineProvider = object : ViewOutlineProvider() {
                override fun getOutline(view: View, outline: Outline) {
                    if (round) outline.setOval(0, 0, view.width, view.height)
                    else outline.setRoundRect(0, 0, view.width, view.height, dp(12f).toFloat())
                }
            }
            clipToOutline = true
            layoutParams = LinearLayout.LayoutParams(dp(size), dp(size))
        }

    private fun iconButton(c: Context, icon: Int, size: Float, bg: Int, tint: Int, desc: String, action: () -> Unit) =
        ImageView(c).apply {
            setImageResource(icon)
            setColorFilter(tint)
            val pad = dp(size * 0.24f)
            setPadding(pad, pad, pad, pad)
            background = circle(bg)
            contentDescription = desc
            setOnClickListener { action() }
            layoutParams = LinearLayout.LayoutParams(dp(size), dp(size))
        }

    private fun hiddenView(c: Context, showTitle: Boolean): View = LinearLayout(c).apply {
        orientation = LinearLayout.HORIZONTAL
        gravity = Gravity.CENTER_VERTICAL
        setPadding(dp(4f), 0, dp(11f), 0)
        background = panelBg(15f)
        contentDescription = "Nova: $title. Tap buat kontrol lagu"
        addView(coverView(c, 22f, true))
        if (showTitle) {
            addView(
                TextView(c).apply {
                    text = title
                    setTextColor(this@NovaOverlay.text)
                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
                    paint.isFakeBoldText = true
                    isSingleLine = true
                    ellipsize = TextUtils.TruncateAt.MARQUEE
                    marqueeRepeatLimit = -1
                    isSelected = true
                },
                LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f).apply {
                    marginStart = dp(8f)
                    marginEnd = dp(8f)
                },
            )
        } else {
            addView(View(c), LinearLayout.LayoutParams(0, 1, 1f))
        }
        val barColor = if (playing) accent else muted
        for ((i, h) in listOf(7f, 12f, 9f).withIndex()) {
            addView(
                View(c).apply {
                    background = GradientDrawable().apply {
                        setColor(barColor)
                        cornerRadius = dp(1.5f).toFloat()
                    }
                },
                LinearLayout.LayoutParams(dp(3f), dp(h)).apply { if (i > 0) marginStart = dp(2f) },
            )
        }
    }

    private fun pillView(c: Context): View = LinearLayout(c).apply {
        orientation = LinearLayout.HORIZONTAL
        gravity = Gravity.CENTER_VERTICAL
        setPadding(dp(5f), 0, dp(4f), 0)
        background = panelBg(17f)
        contentDescription = "Nova: $title"
        addView(coverView(c, 24f, true))
        addView(
            TextView(c).apply {
                text = title
                setTextColor(this@NovaOverlay.text)
                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
                paint.isFakeBoldText = true
                isSingleLine = true
                ellipsize = TextUtils.TruncateAt.MARQUEE
                marqueeRepeatLimit = -1
                isSelected = true
            },
            LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f).apply {
                marginStart = dp(8f)
                marginEnd = dp(4f)
            },
        )
        addView(
            iconButton(
                c,
                if (playing) android.R.drawable.ic_media_pause else android.R.drawable.ic_media_play,
                28f, Color.TRANSPARENT, accent, "Putar atau jeda",
            ) { mediaKey(c, KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE) }
        )
    }

    // ---- Progres & favorit dari Dart (dikirim tiap detik), diupdate di tempat ----
    private var posMs = 0L
    private var durMs = 0L
    private var fav = false
    private var waveBars: List<View> = emptyList()
    private var posText: TextView? = null
    private var durText: TextView? = null
    private var favText: TextView? = null

    fun progress(pos: Long, dur: Long, isFav: Boolean) {
        posMs = pos
        durMs = dur
        fav = isFav
        bindProgress()
    }

    private fun fmt(ms: Long): String {
        val s = (ms / 1000).coerceAtLeast(0)
        return String.format("%02d:%02d", s / 60, s % 60)
    }

    private fun bindProgress() {
        val f = if (durMs > 0) (posMs.toFloat() / durMs).coerceIn(0f, 1f) else 0f
        val n = waveBars.size
        waveBars.forEachIndexed { i, v ->
            (v.background as? GradientDrawable)?.setColor(
                if ((i + 0.5f) / n <= f) accent else Color.argb(51, 255, 255, 255)
            )
        }
        posText?.text = fmt(posMs)
        durText?.text = fmt(durMs)
        favText?.apply {
            text = if (fav) "♥" else "♡"
            setTextColor(if (fav) accent else Color.WHITE)
        }
    }

    private fun circleText(c: Context, label: String, size: Float, desc: String, action: () -> Unit) =
        TextView(c).apply {
            text = label
            gravity = Gravity.CENTER
            setTextColor(Color.WHITE)
            setTextSize(TypedValue.COMPLEX_UNIT_SP, size * 0.42f)
            background = GradientDrawable().apply {
                shape = GradientDrawable.OVAL
                setColor(Color.argb(31, 255, 255, 255))
                setStroke(dp(1f), Color.argb(26, 255, 255, 255))
            }
            contentDescription = desc
            setOnClickListener { action() }
            layoutParams = LinearLayout.LayoutParams(dp(size), dp(size))
        }

    /** Kartu pemutar ngambang, disamain sama versi di dalam Nova. Tinggi dikunci di render(). */
    @SuppressLint("ClickableViewAccessibility")
    private fun expandedView(c: Context): View = FrameLayout(c).apply {
        background = panelBg(30f)
        clipToOutline = true
        outlineProvider = object : ViewOutlineProvider() {
            override fun getOutline(view: View, outline: Outline) {
                outline.setRoundRect(0, 0, view.width, view.height, dp(30f).toFloat())
            }
        }
        val full = FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT)

        // Latar warna lagu: cover dibesarin + blur, ditimpa gradasi gelap.
        coverBmp?.let { bmp ->
            addView(ImageView(c).apply {
                setImageBitmap(bmp)
                scaleType = ImageView.ScaleType.CENTER_CROP
                scaleX = 1.4f
                scaleY = 1.4f
                if (Build.VERSION.SDK_INT >= 31) {
                    setRenderEffect(
                        android.graphics.RenderEffect.createBlurEffect(
                            dp(30f).toFloat(), dp(30f).toFloat(), android.graphics.Shader.TileMode.CLAMP,
                        )
                    )
                } else {
                    alpha = 0.35f
                }
            }, full)
        }
        addView(View(c).apply {
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.argb(153, 0, 0, 0), Color.argb(230, 0, 0, 0)),
            )
        }, full)

        addView(LinearLayout(c).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(14f), dp(14f), dp(14f), dp(14f))

            // Baris atas: cover · status/judul/artis · equalizer
            addView(LinearLayout(c).apply {
                orientation = LinearLayout.HORIZONTAL
                gravity = Gravity.CENTER_VERTICAL
                setOnClickListener { mode = Mode.HIDDEN; openApp(c) }
                addView(coverView(c, 54f, false).apply { elevation = dp(6f).toFloat() })
                addView(
                    LinearLayout(c).apply {
                        orientation = LinearLayout.VERTICAL
                        addView(TextView(c).apply {
                            text = if (playing) "SEDANG DIPUTAR" else "DIJEDA"
                            setTextColor(accent)
                            setTextSize(TypedValue.COMPLEX_UNIT_SP, 9.5f)
                            letterSpacing = 0.14f
                            typeface = android.graphics.Typeface.MONOSPACE
                            paint.isFakeBoldText = true
                        })
                        addView(TextView(c).apply {
                            text = title
                            setTextColor(Color.WHITE)
                            setTextSize(TypedValue.COMPLEX_UNIT_SP, 16.5f)
                            paint.isFakeBoldText = true
                            isSingleLine = true
                            ellipsize = TextUtils.TruncateAt.MARQUEE
                            marqueeRepeatLimit = -1
                            isSelected = true
                        })
                        addView(TextView(c).apply {
                            text = artist
                            setTextColor(Color.argb(179, 255, 255, 255))
                            setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
                            isSingleLine = true
                            ellipsize = TextUtils.TruncateAt.END
                        })
                    },
                    LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f).apply {
                        marginStart = dp(12f)
                        marginEnd = dp(10f)
                    },
                )
                for ((i, h) in listOf(12f, 22f, 16f).withIndex()) {
                    addView(
                        View(c).apply {
                            background = GradientDrawable().apply {
                                setColor(if (playing) accent else muted)
                                cornerRadius = dp(2f).toFloat()
                            }
                        },
                        LinearLayout.LayoutParams(dp(4f), dp(h)).apply { if (i > 0) marginStart = dp(3f) },
                    )
                }
            })

            // Seek bar gelombang mini (tap / geser = loncat)
            addView(
                LinearLayout(c).apply {
                    orientation = LinearLayout.HORIZONTAL
                    gravity = Gravity.CENTER_VERTICAL
                    val mono = android.graphics.Typeface.MONOSPACE
                    posText = TextView(c).apply {
                        setTextColor(accent)
                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 10.5f)
                        typeface = mono
                    }
                    addView(posText, LinearLayout.LayoutParams(dp(42f), LinearLayout.LayoutParams.WRAP_CONTENT))

                    val wave = LinearLayout(c).apply {
                        orientation = LinearLayout.HORIZONTAL
                        gravity = Gravity.CENTER_VERTICAL
                    }
                    val rnd = java.util.Random(songId)
                    val bars = ArrayList<View>()
                    for (i in 0 until 36) {
                        val h = 0.3f + 0.7f * (0.5f + 0.5f * kotlin.math.sin(i * 0.55f)) * (0.6f + rnd.nextFloat() * 0.4f)
                        val bar = View(c).apply {
                            background = GradientDrawable().apply {
                                setColor(Color.argb(51, 255, 255, 255))
                                cornerRadius = dp(2f).toFloat()
                            }
                        }
                        wave.addView(bar, LinearLayout.LayoutParams(0, dp(18f * h), 1f).apply {
                            if (i > 0) marginStart = dp(2f)
                        })
                        bars.add(bar)
                    }
                    waveBars = bars
                    wave.setOnTouchListener { v, ev ->
                        if (ev.action == MotionEvent.ACTION_UP && v.width > 0 && durMs > 0) {
                            val f = (ev.x / v.width).coerceIn(0f, 1f)
                            posMs = (durMs * f).toLong()
                            bindProgress()
                            channel?.invokeMethod("seek", f.toDouble())
                        }
                        true
                    }
                    addView(wave, LinearLayout.LayoutParams(0, dp(24f), 1f))

                    durText = TextView(c).apply {
                        setTextColor(Color.argb(153, 255, 255, 255))
                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 10.5f)
                        typeface = mono
                        gravity = Gravity.END
                    }
                    addView(durText, LinearLayout.LayoutParams(dp(42f), LinearLayout.LayoutParams.WRAP_CONTENT))
                },
                LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
                    .apply { topMargin = dp(12f) },
            )

            // Kontrol simetris: favorit · sebelumnya · PLAY · berikutnya · buka
            addView(
                LinearLayout(c).apply {
                    orientation = LinearLayout.HORIZONTAL
                    gravity = Gravity.CENTER_VERTICAL
                    val soft = Color.argb(31, 255, 255, 255)
                    fun gap() = View(c).apply { layoutParams = LinearLayout.LayoutParams(0, 1, 1f) }
                    favText = circleText(c, "♡", 40f, "Favorit") {
                        fav = !fav
                        bindProgress()
                        channel?.invokeMethod("toggleFav", null)
                    }
                    addView(favText)
                    addView(gap())
                    addView(iconButton(c, android.R.drawable.ic_media_previous, 48f, soft, Color.WHITE, "Lagu sebelumnya") {
                        mediaKey(c, KeyEvent.KEYCODE_MEDIA_PREVIOUS)
                    })
                    addView(gap())
                    addView(
                        iconButton(
                            c,
                            if (playing) android.R.drawable.ic_media_pause else android.R.drawable.ic_media_play,
                            58f, Color.WHITE, Color.BLACK, "Putar atau jeda",
                        ) { mediaKey(c, KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE) }
                    )
                    addView(gap())
                    addView(iconButton(c, android.R.drawable.ic_media_next, 48f, soft, Color.WHITE, "Lagu berikutnya") {
                        mediaKey(c, KeyEvent.KEYCODE_MEDIA_NEXT)
                    })
                    addView(gap())
                    addView(circleText(c, "↗", 40f, "Buka pemutar") {
                        mode = Mode.HIDDEN
                        openApp(c)
                    })
                },
                LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
                    .apply { topMargin = dp(12f) },
            )
        }, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT))

        bindProgress()
    }

    /** Pegangan kaca: kapsul tipis bening berbingkai, area tap-nya lebih besar dari tampilannya. */
    private fun handleView(c: Context): View = View(c).apply {
        background = GradientDrawable().apply {
            setColor(Color.argb(70, 255, 255, 255))
            cornerRadius = dp(5f).toFloat()
            setStroke(dp(1f), Color.argb(120, 255, 255, 255))
        }
        contentDescription = "Nova: munculin pulau lagu"
    }

    private fun space(c: Context, w: Float) = View(c).apply {
        layoutParams = LinearLayout.LayoutParams(dp(w), 1)
    }

    private fun openApp(c: Context) {
        val intent = c.packageManager.getLaunchIntentForPackage(c.packageName) ?: return
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT)
        c.startActivity(intent)
    }

    private fun mediaKey(c: Context, code: Int) {
        val am = c.getSystemService(Context.AUDIO_SERVICE) as AudioManager
        am.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, code))
        am.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_UP, code))
    }
}


/**
 * Widget layar utama: cover + judul + tombol sebelumnya/putar/berikutnya.
 * Tombol dikirim sebagai tombol media ke AudioService (jalan walau Nova lagi di belakang).
 * Info terakhir disimpan, jadi widget tetap keisi setelah HP restart.
 */
class NovaWidget : AppWidgetProvider() {
    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
        render(context)
    }

    companion object {
        private const val PREFS = "nova_widget"
        private val main = Handler(Looper.getMainLooper())

        /** Ada kabar dari Nova sejak proses ini jalan? Kalau belum, anggap lagi gak muter. */
        @Volatile private var live = false
        private var cover: Bitmap? = null
        private var coverId = Long.MIN_VALUE

        fun update(ctx: Context, id: Long, title: String, artist: String, playing: Boolean, accent: Int?) {
            live = true
            val p = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
            val same = p.getLong("id", -1L) == id && p.getString("title", "") == title &&
                p.getString("artist", "") == artist && p.getBoolean("playing", false) == playing &&
                (accent == null || p.getInt("accent", 0) == accent)
            if (same && coverId == id) return
            p.edit()
                .putLong("id", id)
                .putString("title", title)
                .putString("artist", artist)
                .putBoolean("playing", playing)
                .apply { if (accent != null) putInt("accent", accent) }
                .apply()
            render(ctx)
        }

        fun render(context: Context) {
            val ctx = context.applicationContext
            val mgr = AppWidgetManager.getInstance(ctx)
            val ids = mgr.getAppWidgetIds(ComponentName(ctx, NovaWidget::class.java))
            if (ids.isEmpty()) return

            val p = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
            val id = p.getLong("id", -1L)
            val title = p.getString("title", "") ?: ""
            val artist = p.getString("artist", "") ?: ""
            val playing = live && p.getBoolean("playing", false)
            val accent = p.getInt("accent", Color.rgb(174, 185, 255))
            val density = ctx.resources.displayMetrics.density

            // Cover dimuat di belakang, lalu widget digambar ulang.
            if (id != coverId) {
                coverId = id
                cover = null
                if (id >= 0) {
                    NovaMedia.io.execute {
                        val bmp = try {
                            NovaMedia.artworkBitmap(ctx, id, 220)?.let { rounded(it, (52 * density).toInt(), 14 * density) }
                        } catch (e: Exception) {
                            null
                        }
                        main.post {
                            if (coverId == id && bmp != null) {
                                cover = bmp
                                render(ctx)
                            }
                        }
                    }
                }
            }

            val v = RemoteViews(ctx.packageName, R.layout.nova_widget)
            val hasSong = id >= 0 && title.isNotEmpty()
            v.setTextViewText(R.id.w_status, if (!hasSong) "NOVA" else if (playing) "SEDANG DIPUTAR" else "DIJEDA")
            v.setTextColor(R.id.w_status, accent)
            v.setTextViewText(R.id.w_title, if (hasSong) title else "Musikmu, tanpa jeda.")
            v.setTextViewText(R.id.w_artist, if (hasSong) artist.ifEmpty { "Artis tidak dikenal" } else "Tap buat buka Nova")
            val c = cover
            if (c != null) v.setImageViewBitmap(R.id.w_cover, c) else v.setImageViewResource(R.id.w_cover, R.drawable.nova_widget_cover)
            v.setImageViewBitmap(R.id.w_play, playButton((46 * density).toInt(), accent, playing))
            v.setContentDescription(R.id.w_play, if (playing) "Jeda" else "Putar")

            val launch = ctx.packageManager.getLaunchIntentForPackage(ctx.packageName)
            if (launch != null) {
                v.setOnClickPendingIntent(
                    R.id.w_info,
                    PendingIntent.getActivity(ctx, 40, launch, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE),
                )
                v.setOnClickPendingIntent(
                    R.id.w_cover,
                    PendingIntent.getActivity(ctx, 41, launch, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE),
                )
            }
            v.setOnClickPendingIntent(R.id.w_prev, media(ctx, KeyEvent.KEYCODE_MEDIA_PREVIOUS, 42))
            v.setOnClickPendingIntent(
                R.id.w_play,
                media(ctx, if (playing) KeyEvent.KEYCODE_MEDIA_PAUSE else KeyEvent.KEYCODE_MEDIA_PLAY, 43),
            )
            v.setOnClickPendingIntent(R.id.w_next, media(ctx, KeyEvent.KEYCODE_MEDIA_NEXT, 44))
            mgr.updateAppWidget(ids, v)
        }

        private fun media(ctx: Context, code: Int, req: Int): PendingIntent {
            val i = Intent(Intent.ACTION_MEDIA_BUTTON)
                .setComponent(ComponentName(ctx, "com.ryanheise.audioservice.MediaButtonReceiver"))
                .putExtra(Intent.EXTRA_KEY_EVENT, KeyEvent(KeyEvent.ACTION_DOWN, code))
            return PendingIntent.getBroadcast(ctx, req, i, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
        }

        /** Cover dipotong kotak di tengah, sudut membulat. */
        private fun rounded(src: Bitmap, size: Int, radius: Float): Bitmap {
            val side = minOf(src.width, src.height)
            val square = Bitmap.createBitmap(src, (src.width - side) / 2, (src.height - side) / 2, side, side)
            val scaled = Bitmap.createScaledBitmap(square, size, size, true)
            val out = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
            val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                shader = BitmapShader(scaled, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
            }
            Canvas(out).drawRoundRect(RectF(0f, 0f, size.toFloat(), size.toFloat()), radius, radius, paint)
            return out
        }

        /** Tombol putar bulat warna aksen, ikon digambar langsung (biar warnanya ikut cover). */
        private fun playButton(size: Int, accent: Int, playing: Boolean): Bitmap {
            val out = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
            val canvas = Canvas(out)
            val s = size.toFloat()
            canvas.drawCircle(s / 2, s / 2, s / 2, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = accent })
            val lum = (0.2126 * Color.red(accent) + 0.7152 * Color.green(accent) + 0.0722 * Color.blue(accent)) / 255
            val glyph = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                color = if (lum > 0.55) Color.rgb(12, 16, 30) else Color.WHITE
            }
            if (playing) {
                val w = s * 0.11f
                val h = s * 0.36f
                val gap = s * 0.08f
                val top = (s - h) / 2
                val r = w / 2
                canvas.drawRoundRect(RectF(s / 2 - gap / 2 - w, top, s / 2 - gap / 2, top + h), r, r, glyph)
                canvas.drawRoundRect(RectF(s / 2 + gap / 2, top, s / 2 + gap / 2 + w, top + h), r, r, glyph)
            } else {
                val h = s * 0.38f
                val left = s * 0.39f
                val path = Path().apply {
                    moveTo(left, (s - h) / 2)
                    lineTo(left + h * 0.87f, s / 2)
                    lineTo(left, (s + h) / 2)
                    close()
                }
                glyph.strokeJoin = Paint.Join.ROUND
                glyph.style = Paint.Style.FILL_AND_STROKE
                glyph.strokeWidth = s * 0.03f
                canvas.drawPath(path, glyph)
            }
            return out
        }
    }
}
