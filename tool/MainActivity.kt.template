/**
 * Nova:
 * - channel "nova/media": daftar lagu + cover dari MediaStore, dan "moveToBack".
 * - channel "nova/overlay": pulau di notch yang tetap tampil di luar app.
 */
class MainActivity : AudioServiceActivity() {
    private val main = Handler(Looper.getMainLooper())

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        NovaOverlay.init(applicationContext)
        val messenger = flutterEngine.dartExecutor.binaryMessenger

        MethodChannel(messenger, "nova/media").setMethodCallHandler { call, result ->
            when (call.method) {
                "songs" -> NovaMedia.io.execute {
                    try {
                        val list = NovaMedia.querySongs(applicationContext)
                        main.post { result.success(list) }
                    } catch (e: Exception) {
                        main.post { result.error("query", e.message, null) }
                    }
                }
                "artwork" -> {
                    val id = call.argument<Number>("id")?.toLong()
                    val size = call.argument<Number>("size")?.toInt() ?: 300
                    if (id == null) {
                        result.success(null)
                    } else {
                        NovaMedia.io.execute {
                            val bytes = try {
                                NovaMedia.artworkBytes(applicationContext, id, size)
                            } catch (e: Exception) {
                                null
                            }
                            main.post { result.success(bytes) }
                        }
                    }
                }
                // Tombol back di layar utama: sembunyikan app, musik tetap jalan.
                "moveToBack" -> {
                    moveTaskToBack(true)
                    result.success(null)
                }
                else -> result.notImplemented()
            }
        }

        MethodChannel(messenger, "nova/overlay").setMethodCallHandler { call, result ->
            when (call.method) {
                "canDraw" -> result.success(NovaOverlay.canDraw(this))
                "requestPermission" -> {
                    try {
                        startActivity(
                            Intent(
                                Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                                Uri.parse("package:$packageName"),
                            )
                        )
                    } catch (e: Exception) {
                        startActivity(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION))
                    }
                    result.success(null)
                }
                "setEnabled" -> {
                    NovaOverlay.enabled = call.arguments as? Boolean ?: false
                    NovaOverlay.refresh()
                    result.success(null)
                }
                "update" -> {
                    NovaOverlay.update(
                        id = call.argument<Number>("id")?.toLong() ?: -1L,
                        title = call.argument<String>("title") ?: "",
                        artist = call.argument<String>("artist") ?: "",
                        playing = call.argument<Boolean>("playing") ?: false,
                    )
                    result.success(null)
                }
                "test" -> result.success(NovaOverlay.test())
                else -> result.notImplemented()
            }
        }
    }

    override fun onStart() {
        super.onStart()
        NovaOverlay.setAppVisible(true)
    }

    override fun onStop() {
        super.onStop()
        NovaOverlay.setAppVisible(false)
    }
}

/** Baca lagu & cover dari MediaStore. */
object NovaMedia {
    val io = Executors.newFixedThreadPool(3)

    @Suppress("DEPRECATION")
    fun querySongs(ctx: Context): List<Map<String, Any?>> {
        val uri = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
        val projection = arrayOf(
            MediaStore.Audio.Media._ID,
            MediaStore.Audio.Media.TITLE,
            MediaStore.Audio.Media.ARTIST,
            MediaStore.Audio.Media.ALBUM,
            MediaStore.Audio.Media.ALBUM_ID,
            MediaStore.Audio.Media.DURATION,
            MediaStore.Audio.Media.DATE_ADDED,
            MediaStore.Audio.Media.DATA,
        )
        val out = ArrayList<Map<String, Any?>>()
        ctx.contentResolver.query(
            uri,
            projection,
            "${MediaStore.Audio.Media.IS_MUSIC} != 0",
            null,
            "${MediaStore.Audio.Media.DATE_ADDED} DESC",
        )?.use { c ->
            val iId = c.getColumnIndexOrThrow(MediaStore.Audio.Media._ID)
            val iTitle = c.getColumnIndexOrThrow(MediaStore.Audio.Media.TITLE)
            val iArtist = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ARTIST)
            val iAlbum = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ALBUM)
            val iAlbumId = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ALBUM_ID)
            val iDur = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DURATION)
            val iDate = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DATE_ADDED)
            val iData = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DATA)
            while (c.moveToNext()) {
                val id = c.getLong(iId)
                out.add(
                    mapOf(
                        "id" to id,
                        "title" to c.getString(iTitle),
                        "artist" to c.getString(iArtist),
                        "album" to c.getString(iAlbum),
                        "albumId" to c.getLong(iAlbumId),
                        "duration" to c.getLong(iDur),
                        "dateAdded" to c.getLong(iDate),
                        "path" to (c.getString(iData) ?: ""),
                        "uri" to ContentUris.withAppendedId(uri, id).toString(),
                    )
                )
            }
        }
        return out
    }

    fun artworkBitmap(ctx: Context, id: Long, size: Int): Bitmap? {
        val retriever = MediaMetadataRetriever()
        try {
            retriever.setDataSource(
                ctx,
                ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, id),
            )
            val pic = retriever.embeddedPicture ?: return null
            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
            BitmapFactory.decodeByteArray(pic, 0, pic.size, bounds)
            var sample = 1
            while (bounds.outWidth / (sample * 2) >= size && bounds.outHeight / (sample * 2) >= size) {
                sample *= 2
            }
            val opts = BitmapFactory.Options().apply { inSampleSize = sample }
            return BitmapFactory.decodeByteArray(pic, 0, pic.size, opts)
        } finally {
            try {
                retriever.release()
            } catch (e: Exception) {
                // abaikan
            }
        }
    }

    fun artworkBytes(ctx: Context, id: Long, size: Int): ByteArray? {
        val bmp = artworkBitmap(ctx, id, size) ?: return null
        val stream = ByteArrayOutputStream()
        bmp.compress(Bitmap.CompressFormat.JPEG, 88, stream)
        bmp.recycle()
        return stream.toByteArray()
    }
}

/**
 * Pulau di notch versi luar app (izin "tampil di atas app lain").
 * Tiga tahap:
 *  - HIDDEN  : kapsul kecil di notch. Tap = muncul jadi pil.
 *  - PILL    : cover + judul + play/jeda. Tap = kartu lagu, geser ke atas = sembunyi.
 *  - EXPANDED: kartu kayak notifikasi (sebelumnya / play / berikutnya / buka Nova).
 *              Tap kosong / tap di luar = balik ke pil, geser ke atas = sembunyi.
 */
@SuppressLint("StaticFieldLeak")
object NovaOverlay {
    enum class Mode { HIDDEN, PILL, EXPANDED }

    var enabled = false

    private var ctx: Context? = null
    private val main = Handler(Looper.getMainLooper())
    private var appVisible = true
    private var mode = Mode.HIDDEN
    private var testUntil = 0L

    private var songId = -1L
    private var title = ""
    private var artist = ""
    private var playing = false
    private var coverBmp: Bitmap? = null

    private var root: FrameLayout? = null
    private var params: WindowManager.LayoutParams? = null

    private val text = Color.rgb(236, 238, 245)
    private val muted = Color.rgb(143, 149, 168)
    private val accent = Color.rgb(174, 185, 255)
    private val onAccent = Color.rgb(12, 16, 48)

    fun init(c: Context) {
        if (ctx == null) ctx = c.applicationContext
    }

    private var probedOk = false

    /**
     * Cek izin "tampil di atas app lain" berlapis. Oppo/ColorOS kadang balikin false
     * dari Settings.canDrawOverlays walau saklarnya udah nyala.
     */
    fun canDraw(c: Context): Boolean {
        if (Build.VERSION.SDK_INT < 23 || probedOk) return true
        if (Settings.canDrawOverlays(c)) return true
        try {
            val ops = c.getSystemService(Context.APP_OPS_SERVICE) as AppOpsManager
            val mode = if (Build.VERSION.SDK_INT >= 29) {
                ops.unsafeCheckOpNoThrow(AppOpsManager.OPSTR_SYSTEM_ALERT_WINDOW, Process.myUid(), c.packageName)
            } else {
                @Suppress("DEPRECATION")
                ops.checkOpNoThrow(AppOpsManager.OPSTR_SYSTEM_ALERT_WINDOW, Process.myUid(), c.packageName)
            }
            if (mode == AppOpsManager.MODE_ALLOWED) return true
        } catch (e: Exception) {
            // lanjut ke cara terakhir
        }
        return probe(c)
    }

    /** Coba tempel jendela 1px tak terlihat. Kalau sistem nerima, izinnya sebenernya ada. */
    private fun probe(c: Context): Boolean {
        if (Looper.myLooper() != Looper.getMainLooper()) return false
        @Suppress("DEPRECATION")
        val type = if (Build.VERSION.SDK_INT >= 26) {
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
        } else {
            WindowManager.LayoutParams.TYPE_PHONE
        }
        val view = View(c)
        val p = WindowManager.LayoutParams(
            1, 1, type,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE,
            PixelFormat.TRANSLUCENT,
        )
        return try {
            val wm = c.getSystemService(Context.WINDOW_SERVICE) as WindowManager
            wm.addView(view, p)
            wm.removeView(view)
            probedOk = true
            true
        } catch (e: Exception) {
            false
        }
    }

    fun setAppVisible(visible: Boolean) {
        appVisible = visible
        refresh()
    }

    fun update(id: Long, title: String, artist: String, playing: Boolean) {
        val changed = id != songId
        songId = id
        this.title = title
        this.artist = artist
        this.playing = playing
        if (changed) {
            coverBmp = null
            loadCover()
        }
        refresh()
        render()
    }

    /** Tampilkan pil 5 detik walau Nova lagi dibuka, buat ngetes izin. Balikin pesan error kalau gagal. */
    fun test(): String? {
        val c = ctx ?: return "Nova belum siap"
        if (!canDraw(c)) return "Izin \"tampil di atas aplikasi lain\" belum aktif"
        if (songId < 0) return "Putar satu lagu dulu"
        testUntil = System.currentTimeMillis() + 5000
        mode = Mode.EXPANDED
        main.postDelayed({ refresh() }, 5100)
        return refresh()
    }

    fun refresh(): String? {
        val c = ctx ?: return null
        val testing = System.currentTimeMillis() < testUntil
        val show = (enabled || testing) && (!appVisible || testing) && songId >= 0 && canDraw(c)
        return if (show) attach(c) else {
            detach()
            null
        }
    }

    private fun dp(v: Float): Int {
        val c = ctx ?: return v.toInt()
        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, c.resources.displayMetrics).toInt()
    }

    private fun loadCover() {
        val c = ctx ?: return
        val id = songId
        NovaMedia.io.execute {
            val bmp = try {
                NovaMedia.artworkBitmap(c, id, 160)
            } catch (e: Exception) {
                null
            }
            main.post {
                if (id == songId) {
                    coverBmp = bmp
                    render()
                }
            }
        }
    }

    private fun wm(c: Context) = c.getSystemService(Context.WINDOW_SERVICE) as WindowManager

    @SuppressLint("ClickableViewAccessibility")
    private fun attach(c: Context): String? {
        if (root != null) return null
        val frame = FrameLayout(c)

        val gestures = GestureDetector(c, object : GestureDetector.SimpleOnGestureListener() {
            override fun onDown(e: MotionEvent): Boolean = true

            override fun onSingleTapUp(e: MotionEvent): Boolean {
                setMode(if (mode == Mode.HIDDEN) Mode.EXPANDED else Mode.HIDDEN)
                return true
            }

            override fun onFling(e1: MotionEvent?, e2: MotionEvent, vx: Float, vy: Float): Boolean {
                if (vy < -500 && mode != Mode.HIDDEN) {
                    setMode(Mode.HIDDEN)
                    return true
                }
                if (vy > 500 && mode != Mode.EXPANDED) {
                    setMode(Mode.EXPANDED)
                    return true
                }
                return false
            }

            override fun onLongPress(e: MotionEvent) {
                openApp(c)
            }
        })
        frame.setOnTouchListener { _, ev ->
            if (ev.action == MotionEvent.ACTION_OUTSIDE) {
                if (mode == Mode.EXPANDED) setMode(Mode.HIDDEN)
                true
            } else {
                gestures.onTouchEvent(ev)
            }
        }

        @Suppress("DEPRECATION")
        val type = if (Build.VERSION.SDK_INT >= 26) {
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
        } else {
            WindowManager.LayoutParams.TYPE_PHONE
        }
        val p = WindowManager.LayoutParams(
            dp(210f),
            dp(34f),
            type,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH or
                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT,
        ).apply {
            gravity = Gravity.TOP or Gravity.CENTER_HORIZONTAL
            if (Build.VERSION.SDK_INT >= 28) {
                layoutInDisplayCutoutMode =
                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
            }
        }

        try {
            wm(c).addView(frame, p)
        } catch (e: Exception) {
            return "Gagal tampil: ${e.javaClass.simpleName} ${e.message ?: ""}".trim()
        }
        root = frame
        params = p
        render()
        return null
    }

    private fun detach() {
        val view = root ?: return
        root = null
        params = null
        try {
            ctx?.let { wm(it).removeView(view) }
        } catch (e: Exception) {
            // abaikan
        }
    }

    private fun setMode(m: Mode) {
        mode = m
        render()
    }

    private fun statusBarHeight(c: Context): Int {
        val id = c.resources.getIdentifier("status_bar_height", "dimen", "android")
        return if (id > 0) c.resources.getDimensionPixelSize(id) else dp(24f)
    }

    /** Bangun ulang isi pulau sesuai tahap sekarang. */
    private fun render() {
        val c = ctx ?: return
        val frame = root ?: return
        val p = params ?: return
        frame.removeAllViews()
        val statusH = statusBarHeight(c)
        val screenW = c.resources.displayMetrics.widthPixels

        val child: View = when (mode) {
            // Kapsul kecil ngelilingin lubang kamera: cover di kiri, equalizer di kanan,
            // tengahnya kosong biar gak ketutup kamera.
            Mode.HIDDEN, Mode.PILL -> {
                p.width = dp(104f)
                p.height = dp(28f)
                p.y = maxOf(dp(4f), (statusH - dp(28f)) / 2)
                hiddenView(c)
            }
            // Kartu pemutar ngambang di bawah status bar.
            Mode.EXPANDED -> {
                p.width = screenW - dp(20f)
                p.height = WindowManager.LayoutParams.WRAP_CONTENT
                p.y = statusH + dp(8f)
                expandedView(c)
            }
        }
        frame.addView(
            child,
            FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                if (mode == Mode.EXPANDED) FrameLayout.LayoutParams.WRAP_CONTENT
                else FrameLayout.LayoutParams.MATCH_PARENT,
            ),
        )
        try {
            wm(c).updateViewLayout(frame, p)
        } catch (e: Exception) {
            // abaikan
        }
        child.alpha = 0f
        child.scaleX = 0.92f
        child.scaleY = 0.92f
        child.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(180).start()
    }

    private fun panelBg(radius: Float) = GradientDrawable().apply {
        setColor(Color.BLACK)
        cornerRadius = dp(radius).toFloat()
        setStroke(dp(1f), Color.argb(34, 255, 255, 255))
    }

    private fun circle(color: Int) = GradientDrawable().apply {
        shape = GradientDrawable.OVAL
        setColor(color)
    }

    private fun coverView(c: Context, size: Float, round: Boolean): ImageView =
        ImageView(c).apply {
            scaleType = ImageView.ScaleType.CENTER_CROP
            setBackgroundColor(Color.argb(30, 255, 255, 255))
            coverBmp?.let { setImageBitmap(it) }
            outlineProvider = object : ViewOutlineProvider() {
                override fun getOutline(view: View, outline: Outline) {
                    if (round) outline.setOval(0, 0, view.width, view.height)
                    else outline.setRoundRect(0, 0, view.width, view.height, dp(12f).toFloat())
                }
            }
            clipToOutline = true
            layoutParams = LinearLayout.LayoutParams(dp(size), dp(size))
        }

    private fun iconButton(c: Context, icon: Int, size: Float, bg: Int, tint: Int, desc: String, action: () -> Unit) =
        ImageView(c).apply {
            setImageResource(icon)
            setColorFilter(tint)
            val pad = dp(size * 0.24f)
            setPadding(pad, pad, pad, pad)
            background = circle(bg)
            contentDescription = desc
            setOnClickListener { action() }
            layoutParams = LinearLayout.LayoutParams(dp(size), dp(size))
        }

    private fun hiddenView(c: Context): View = LinearLayout(c).apply {
        orientation = LinearLayout.HORIZONTAL
        gravity = Gravity.CENTER_VERTICAL
        setPadding(dp(4f), 0, dp(10f), 0)
        background = panelBg(14f)
        contentDescription = "Nova: $title. Tap buat kontrol lagu"
        addView(coverView(c, 20f, true))
        addView(View(c), LinearLayout.LayoutParams(0, 1, 1f))
        val barColor = if (playing) accent else muted
        for ((i, h) in listOf(7f, 12f, 9f).withIndex()) {
            addView(
                View(c).apply {
                    background = GradientDrawable().apply {
                        setColor(barColor)
                        cornerRadius = dp(1.5f).toFloat()
                    }
                },
                LinearLayout.LayoutParams(dp(3f), dp(h)).apply { if (i > 0) marginStart = dp(2f) },
            )
        }
    }

    private fun pillView(c: Context): View = LinearLayout(c).apply {
        orientation = LinearLayout.HORIZONTAL
        gravity = Gravity.CENTER_VERTICAL
        setPadding(dp(5f), 0, dp(4f), 0)
        background = panelBg(17f)
        contentDescription = "Nova: $title"
        addView(coverView(c, 24f, true))
        addView(
            TextView(c).apply {
                text = title
                setTextColor(this@NovaOverlay.text)
                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
                paint.isFakeBoldText = true
                isSingleLine = true
                ellipsize = TextUtils.TruncateAt.MARQUEE
                marqueeRepeatLimit = -1
                isSelected = true
            },
            LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f).apply {
                marginStart = dp(8f)
                marginEnd = dp(4f)
            },
        )
        addView(
            iconButton(
                c,
                if (playing) android.R.drawable.ic_media_pause else android.R.drawable.ic_media_play,
                28f, Color.TRANSPARENT, accent, "Putar atau jeda",
            ) { mediaKey(c, KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE) }
        )
    }

    private fun expandedView(c: Context): View = LinearLayout(c).apply {
        orientation = LinearLayout.VERTICAL
        setPadding(dp(16f), dp(16f), dp(16f), dp(14f))
        background = panelBg(30f)

        addView(LinearLayout(c).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
            addView(coverView(c, 52f, false))
            addView(
                LinearLayout(c).apply {
                    orientation = LinearLayout.VERTICAL
                    addView(TextView(c).apply {
                        text = title
                        setTextColor(this@NovaOverlay.text)
                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
                        paint.isFakeBoldText = true
                        isSingleLine = true
                        ellipsize = TextUtils.TruncateAt.END
                    })
                    addView(TextView(c).apply {
                        text = artist
                        setTextColor(muted)
                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
                        isSingleLine = true
                        ellipsize = TextUtils.TruncateAt.END
                    })
                },
                LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f).apply {
                    marginStart = dp(12f)
                },
            )
        })

        addView(
            LinearLayout(c).apply {
                orientation = LinearLayout.HORIZONTAL
                gravity = Gravity.CENTER_VERTICAL
                val soft = Color.argb(26, 255, 255, 255)
                addView(iconButton(c, android.R.drawable.ic_media_previous, 46f, soft, text, "Lagu sebelumnya") {
                    mediaKey(c, KeyEvent.KEYCODE_MEDIA_PREVIOUS)
                })
                addView(space(c, 10f))
                addView(
                    iconButton(
                        c,
                        if (playing) android.R.drawable.ic_media_pause else android.R.drawable.ic_media_play,
                        52f, accent, onAccent, "Putar atau jeda",
                    ) { mediaKey(c, KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE) }
                )
                addView(space(c, 10f))
                addView(iconButton(c, android.R.drawable.ic_media_next, 46f, soft, text, "Lagu berikutnya") {
                    mediaKey(c, KeyEvent.KEYCODE_MEDIA_NEXT)
                })
                addView(View(c), LinearLayout.LayoutParams(0, 1, 1f))
                addView(TextView(c).apply {
                    text = "Buka Nova"
                    setTextColor(this@NovaOverlay.text)
                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
                    paint.isFakeBoldText = true
                    gravity = Gravity.CENTER
                    setPadding(dp(16f), 0, dp(16f), 0)
                    background = GradientDrawable().apply {
                        setColor(soft)
                        cornerRadius = dp(23f).toFloat()
                    }
                    setOnClickListener {
                        mode = Mode.HIDDEN
                        openApp(c)
                    }
                    layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.WRAP_CONTENT, dp(46f))
                })
            },
            LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
                .apply { topMargin = dp(14f) },
        )
    }

    private fun space(c: Context, w: Float) = View(c).apply {
        layoutParams = LinearLayout.LayoutParams(dp(w), 1)
    }

    private fun openApp(c: Context) {
        val intent = c.packageManager.getLaunchIntentForPackage(c.packageName) ?: return
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT)
        c.startActivity(intent)
    }

    private fun mediaKey(c: Context, code: Int) {
        val am = c.getSystemService(Context.AUDIO_SERVICE) as AudioManager
        am.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, code))
        am.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_UP, code))
    }
}
